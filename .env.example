# Copy to .env and fill locally. Never commit real credentials.
# Telegram: separate test bot; numeric Telegram user ID for the administrator.
BOT_TOKEN=
ADMIN_ID=0
BOT_USERNAME=

# AI
ANTHROPIC_API_KEY=
# Optional; leave blank for direct API access.
ANTHROPIC_PROXY_URL=

# YooKassa: use a test shop while verifying payments.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
WEBHOOK_SECRET=

# HTTPS URL ending in /miniapp (no trailing slash).
MINIAPP_URL=
# Set independent, strong random values before exposing the CRM.
CRM_PASSWORD=
CRM_SESSION_SECRET=

# Optional links; blank PDF links use local private files in materials/.
PAYMENT_URL=
SESSION_URL=
MATERIALS_URL=
PDF_SCANNER=
PDF_CATASTROPHIST=
PDF_FREEZER=
PDF_CONTROLLER=
GROUP_PROGRAM_LINK=

# Defaults in config.py. Some offers also contain prices in code/text.
SESSION_PRICE=5000
PRODUCT_PRICE=1490
GROUP_PROGRAM_PRICE=3000
